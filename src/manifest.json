{
  "manifest_version": 3,
  "name": "ことばレンズ",
  "version": "0.2.0",
  "description": "ページ全体をローカルAIで理解し、3行要約と選択箇所の文脈解説を提供します。",
  "minimum_chrome_version": "138",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "3行要約を表示"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
